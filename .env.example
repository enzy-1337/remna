# --- Общее (Docker / логи) ---
# Часовой пояс процессов в контейнерах (date, %(asctime)s в логах). В БД по-прежнему UTC. Переопределяет значение по умолчанию из docker-compose.
TZ=Europe/Moscow

# Политика restart для всех долгоживущих контейнеров в docker-compose (кроме одноразового migrate).
# На VPS с автозапуском через systemd (remna-bot.service) держите no: иначе после reboot Docker Engine
# поднимает контейнеры сам, иногда без согласованной сети compose → ошибка «network ... not found».
# Если нужен автоперезапуск после падений и вы НЕ используете systemd: unless-stopped
RESTART_POLICY=no

# --- Telegram ---
# Исходящий трафик через SOCKS5 (proxychains4): bot, api, tickets-bot — одинаковые переменные. На хосте должен слушать VPN/клиент (например 7891).
# В Docker по умолчанию хост: host.docker.internal (см. extra_hosts в compose). БД/Redis не проксируются (localnet в scripts/bot-entrypoint.sh).
# На VPS без прямого доступа к api.telegram.org обязательно:
# BOT_PROXYCHAINS_ENABLED=true
# PROXYCHAINS_SOCKS5_HOST=host.docker.internal
# PROXYCHAINS_SOCKS5_PORT=1080
# DNS через SOCKS (по умолчанию выкл. — иначе в Docker не резолвится postgres). Только если реально нужно:
# PROXYCHAINS_PROXY_DNS=true
BOT_TOKEN=
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_CHANNEL_USERNAME=your_channel_username
BOT_USERNAME=
# Подпись рекламной кнопки «перейти в основной бот» (downloader, idbot). {username} — без @
# BOT_CTA_LABEL=💜 VPN · @{username}
# Профиль бота в Telegram (видно до нажатия Start). Пусто — встроенный текст из кода.
# BOT_PROFILE_SHORT_DESCRIPTION=
# BOT_PROFILE_DESCRIPTION=
# Отдельный бот «Узнать ID» (показывает Telegram ID пользователя/чата). Без значения сервис не стартует.
IDBOT_BOT_TOKEN=
DOWNLOADER_BOT_TOKEN=
# ID forum-группы для персональных тем downloader-бота
DOWNLOADER_FORUM_CHAT_ID=
# Music-бот: поиск и скачивание треков
MUSIC_BOT_TOKEN=
MUSIC_FORUM_CHAT_ID=
# VK Music (audio.search) — приоритет в выдаче
VK_ACCESS_TOKEN=
# Опционально: Spotify / Яндекс.Музыка (метаданные; скачивание через YT/VK)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# YANDEX_MUSIC_TOKEN=
# MUSIC_RESULTS_PER_PAGE=8
# MUSIC_MAX_PAGES=10
# Заготовка ограничений (0 = без ограничений)
DOWNLOADER_MAX_FILE_MB=0
DOWNLOADER_MAX_DURATION_SEC=0
SUPPORT_USERNAME=
# Экран «Информация» (политика и оферта; по умолчанию — Telegra.ph)
# INFO_PRIVACY_POLICY_URL=https://telegra.ph/Politika-konfidencialnosti-08-15-17
# INFO_TERMS_OF_SERVICE_URL=https://telegra.ph/Polzovatelskoe-soglashenie-08-15-10
# Админ-лог: ID супергруппы с темами (форум). ADMIN_LOG_TOPIC_ID — запасная тема для всех типов, если отдельная не задана.
ADMIN_LOG_CHAT_ID=
ADMIN_LOG_TOPIC_ID=
# Опционально — своя тема под тип события (число id темы из Telegram). Пусто = использовать ADMIN_LOG_TOPIC_ID.
ADMIN_LOG_TOPIC_GENERAL=
ADMIN_LOG_TOPIC_PAYMENTS=
ADMIN_LOG_TOPIC_USERS=
ADMIN_LOG_TOPIC_TRIALS=
ADMIN_LOG_TOPIC_BONUSES=
ADMIN_LOG_TOPIC_SUBSCRIPTIONS=
ADMIN_LOG_TOPIC_PROMO=
ADMIN_LOG_TOPIC_DEVICES=
ADMIN_LOG_TOPIC_SUPPORT=
ADMIN_LOG_TOPIC_LOGIN=
ADMIN_LOG_TOPIC_BACKUPS=
ADMIN_LOG_TOPIC_REPORTS=
# Сообщение «бот запущен» при старте процесса. Пусто — та же тема, что и ADMIN_LOG_TOPIC_GENERAL / ADMIN_LOG_TOPIC_ID.
ADMIN_LOG_TOPIC_BOOT=
# События подписки/отписки на обязательный новостной канал.
ADMIN_LOG_TOPIC_CHANNEL=
# Технические ошибки (необработанные исключения/logger.error из бота, API, тикетов и др. процессов).
# Пусто — та же тема, что и ADMIN_LOG_TOPIC_GENERAL / ADMIN_LOG_TOPIC_ID.
ADMIN_LOG_TOPIC_ERRORS=
# Антифрод (см. FRAUD_* ниже): подозрения (кнопки Заблокировать/На учёт/Пропустить) и автоблокировки
# (кнопки Разблокировать/В админке) — разные темы, чтобы автоблоки не терялись среди подозрений.
ADMIN_LOG_TOPIC_FRAUD_SUSPICION=
ADMIN_LOG_TOPIC_FRAUD_AUTOBLOCK=
# Ежедневный отчёт (plain-текст) в тему REPORTS, в заданный час UTC (платежи, пользователи, рефералы…)
ADMIN_REPORT_ENABLED=true
ADMIN_REPORT_HOUR_UTC=8
ADMIN_REPORT_TIMEZONE=Europe/Moscow
# Кто видит кнопку «Админ-панель» в профиле: ваш числовой Telegram ID (не username).
# Супер-админ (единственный из env): полный доступ + управление администраторами в веб-панели.
SUPERADMIN_TELEGRAM_ID=883400626
# Устарело: оставлено для совместимости, если SUPERADMIN_TELEGRAM_ID не задан.
ADMIN_TELEGRAM_ID=883400626
# Устарело: список id через запятую; новых админов добавляйте в веб-панели «Администраторы».
ADMIN_TELEGRAM_IDS=

# Ежедневный pg_dump в тему BACKUPS (нужен pg_dump в PATH на сервере бота). Час UTC.
BACKUP_ENABLED=true
BACKUP_HOUR_UTC=6
# Альтернатива UTC-часу: локальный час и таймзона (если BACKUP_HOUR_LOCAL задан, он приоритетнее).
# Для запуска в 03:00 по Москве:
# BACKUP_TIMEZONE=Europe/Moscow
# BACKUP_HOUR_LOCAL=3
# BACKUP_MAX_TELEGRAM_MB=45
# Клиент pg_dump должен быть той же major-версии, что и сервер (иначе server version mismatch):
# BACKUP_PG_DUMP_BIN=/usr/lib/postgresql/16/bin/pg_dump
# Папка проекта для архива и имя в итоговом backup:
# BACKUP_PROJECT_DIR=/app
# BACKUP_PROJECT_NAME=remna-bot
# Локальное хранение копий архивов на сервере + автоочистка:
# BACKUP_LOCAL_DIR=/opt/remna-bot/backups
# BACKUP_LOCAL_RETENTION_DAYS=7

INSTRUCTION_ANDROID_URL=
INSTRUCTION_IOS_URL=
INSTRUCTION_MACOS_URL=
# Telegra.ph (экраны «Инструкции»)
INSTRUCTION_TELEGRAPH_PHONE_URL=
INSTRUCTION_TELEGRAPH_PC_URL=
# Картинка для экранов профиля/подписки: путь к файлу на сервере или URL
BOT_SECTION_PHOTO_PATH=
BOT_SECTION_PHOTO_URL=
# Входящие апдейты бота через API (uvicorn), без polling в python -m bot.main.
# Не включайте одновременно с отдельным контейнером bot на polling — будет дублирование апдейтов.
# TELEGRAM_WEBHOOK_ENABLED=false
# TELEGRAM_WEBHOOK_URL=https://your-api.example.com/webhooks/telegram
# TELEGRAM_WEBHOOK_SECRET=задайте_длинный_секрет_минимум_8_символов

# --- PostgreSQL (asyncpg) ---
DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot
# Будущее: MariaDB не поддерживается в этом репозитории до отдельной миграции (см. docs/mariadb-migration-future.md).

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CHANNEL_SUB_CACHE_TTL=300

# --- Remnawave (отдельный VPS) ---
REMNAWAVE_API_URL=https://remnawave.yourdomain.com
# Если бот на том же сервере и ходит в панель по внутреннему адресу (http://127.0.0.1, docker),
# а пользователям в клиент нужен внешний домен — укажите его здесь; ссылки подписки из API будут переписаны.
# REMNAWAVE_PUBLIC_URL=https://remnawave.yourdomain.com
# Префикс API на nginx (по умолчанию /api → …/api/users). При 404 от nginx попробуйте пусто или свой путь
REMNAWAVE_API_PATH_PREFIX=/api
REMNAWAVE_API_TOKEN=
# Устарело для выдачи сквада в панели (всем ставится sub-opt по умолчанию из кода).
# REMNAWAVE_DEFAULT_SQUAD_UUID=
# Необязательно: свой UUID internal squad вместо встроенного sub-opt (e614816c-de57-49f5-b93f-c6e2cbe8ef56)
REMNAWAVE_OPTIMIZED_SQUAD_UUID=
REMNAWAVE_COOKIE=
# Таймаут HTTP-запросов к панели Remnawave (секунды).
# Влияет и на публичную страницу /sub/<ключ>; при медленной панели увеличьте до 20-30.
REMNAWAVE_REQUEST_TIMEOUT=10
REMNAWAVE_SYNC_ENABLED=true
# false = не запускать массовый sync сразу после старта процесса
REMNAWAVE_SYNC_RUN_IMMEDIATELY=false
# 1800 = 30 минут: импорт пользователей из панели и выравнивание подписок
REMNAWAVE_SYNC_INTERVAL_SEC=1800
# Сколько записей пользователей Remnawave максимум за один проход (с пагинацией)
REMNAWAVE_SYNC_IMPORT_LIMIT=300
# Обновлять поле description в Remnawave (имя, tg, телефон из БД бота)
REMNAWAVE_SYNC_PUSH_DESCRIPTION=true
# Локально без панели: true + можно оставить пустой токен
REMNAWAVE_STUB=false
# Webhooks Remnawave (гибридный биллинг v2)
REMNAWAVE_WEBHOOKS_ENABLED=false
REMNAWAVE_WEBHOOK_SECRET=
REMNAWAVE_WEBHOOK_SIGNATURE_TTL_SEC=300
REMNAWAVE_WEBHOOK_BACKGROUND_PROCESS=true

# --- Триал (по умолчанию выкл.; доступ к VPN — через тарифы и баланс) ---
TRIAL_ENABLED=false
TRIAL_DURATION_DAYS=3
TRIAL_TRAFFIC_GB=1

# Стоимость одного дополнительного слота устройства (₽), шаг 8
EXTRA_DEVICE_PRICE_RUB=65
# Справочная цена ₽/мес за слот сверх включённых (только для отображения; фактическое списание — EXTRA_DEVICE_PRICE_RUB)
EXTRA_DEVICE_MONTHLY_RUB=50
# Сколько слотов устройств входит в базовую подписку без доплаты (задел под будущий помесячный биллинг)
SUBSCRIPTION_INCLUDED_DEVICE_SLOTS=2

# Продажа тарифов с баланса в Telegram-боте (кнопки «Тарифы»); Redis может временно переопределить без перезапуска.
BOT_TARIFF_PURCHASES_ENABLED=true

# --- Billing v2 (гибридный) ---
BILLING_V2_ENABLED=false
# Устарело: перевод legacy→hybrid после окончания подписки не отключается этим флагом.
BILLING_V2_FOR_NEW_USERS_ONLY=false
# Календарные сутки: детализация, суточное списание за устройства, граница календарного месяца для пакетного лимита ГБ (IANA)
BILLING_CALENDAR_TIMEZONE=Europe/Moscow
# Как часто проверять «догонку» ночного списания за устройства (сек)
BILLING_DEVICE_DAILY_JOB_INTERVAL_SEC=120
# PAYG-трафик по панели: ceil(used_gb) через опрос get_user; вебхуки traffic.gb_step не дублируют списание
BILLING_TRAFFIC_RW_METER_ENABLED=true
# Интервал опроса трафика (сек), минимум 30
BILLING_TRAFFIC_METER_POLL_INTERVAL_SEC=120

# --- Антифрод (см. shared/services/fraud/) ---
# Общий рубильник + по одному на детектор. ip_hop/hwid_collision/traffic_spike проходят staged
# rollout (learning -> advisory -> autonomous, управляется из веб-админки /admin/fraud/detectors);
# жёсткое IP-правило (ниже) и внешний blacklist всегда немедленные, staging их не касается.
FRAUD_DETECTION_ENABLED=false
FRAUD_HWID_COLLISION_ENABLED=false
FRAUD_IP_HOP_ENABLED=false
# Интервал опроса Remnawave connections API для детектора смены IP (сек, минимум 15)
FRAUD_IP_HOP_POLL_INTERVAL_SEC=20
# Жёсткое правило вне staged rollout: столько разных IP за окно ниже -> мгновенный автобан
FRAUD_IP_HOP_HARD_BLOCK_IP_COUNT=10
FRAUD_IP_HOP_HARD_BLOCK_WINDOW_SEC=15
# Мягкий порог (идёт через staged rollout, не мгновенный автобан)
FRAUD_IP_HOP_SUSPICIOUS_IP_COUNT=5
FRAUD_IP_HOP_SUSPICIOUS_WINDOW_SEC=30
FRAUD_TRAFFIC_SPIKE_ENABLED=false
# Порог трафика (ГБ) за окно FRAUD_TRAFFIC_SPIKE_WINDOW_SEC для срабатывания
FRAUD_TRAFFIC_SPIKE_GB_THRESHOLD=1.25
FRAUD_TRAFFIC_SPIKE_WINDOW_SEC=60
# Опрос трафика для антифрода — для ВСЕХ пользователей, не зависит от billing_mode
FRAUD_TRAFFIC_SPIKE_POLL_INTERVAL_SEC=30
FRAUD_BLACKLIST_SYNC_ENABLED=false
FRAUD_BLACKLIST_SYNC_INTERVAL_SEC=300
FRAUD_BLACKLIST_URL=https://raw.githubusercontent.com/BEDOLAGA-DEV/VPN-BLACKLIST/refs/heads/main/blacklist.txt

BILLING_DEVICE_DAILY_RUB=2.5
BILLING_GB_STEP_RUB=5
BILLING_MOBILE_GB_EXTRA_RUB=2.5
# Доплата к шагу pay-as-you-go ГБ при включённом «оптимизированном маршруте» у пользователя
BILLING_OPTIMIZED_ROUTE_GB_EXTRA_RUB=2.5
BILLING_BALANCE_FLOOR_RUB=-50
BILLING_MIN_TOPUP_RUB=10
# Фиксированный бонус на первое успешное пополнение (если сумма >= BILLING_FIRST_TOPUP_EXTRA_BALANCE_MIN_RUB).
BILLING_FIRST_TOPUP_FIXED_BONUS_RUB=10
# Первое успешное пополнение: доп. % на баланс от суммы платежа (0 = выключено). Порог минимальной суммы этого платежа.
BILLING_FIRST_TOPUP_EXTRA_BALANCE_PERCENT=0
BILLING_FIRST_TOPUP_EXTRA_BALANCE_MIN_RUB=10
# Первое пополнение без активной подписки: столько первых ГБ в PAYG не тарифицируется (лимит в панели не трогаем). 0 = выкл.
# Отдельный выключатель welcome (как у триала)
BILLING_FIRST_TOPUP_WELCOME_ENABLED=true
BILLING_FIRST_TOPUP_WELCOME_GB=5
BILLING_LEGACY_LIFETIME_CUTOFF_YEAR=2099
BILLING_TRANSITION_BASE_MONTH_RUB=130
BILLING_TRANSITION_FEE_PERCENT=10
BILLING_TRANSITION_CHECK_INTERVAL_SEC=1800
BILLING_DETAIL_RETENTION_DAYS=183
BILLING_NEGATIVE_NOTIFY_ENABLED=true
BILLING_NEGATIVE_NOTIFY_INTERVAL_SEC=900
# Hybrid/PAYG: сколько слотов HWID в панели «включено в подписку» без отдельной оплаты (по умолчанию 15).
BILLING_HYBRID_HWID_SLOTS=15
# ID канала для рассылки «в канал» из web-admin (отрицательное число Telegram, например -1001234567890). 0 или пусто — только пользователям при опции «канал».
BROADCAST_MAIN_CHANNEL_ID=0

# PAYG-автопродление: за 30 дней до конца, при активности за 14 дней и балансе >= 0 продлить без списания.
SUBSCRIPTION_AUTORENEW_ENABLED=true
SUBSCRIPTION_AUTORENEW_INTERVAL_SEC=300
SUBSCRIPTION_AUTORENEW_WINDOW_SEC=3600
# Продление тарифом с баланса только если до конца подписки ≤ N дней (0 = без ограничения)
SUBSCRIPTION_RENEWAL_WINDOW_DAYS=7
# Бонус на баланс при 2-й и далее покупке тарифа с баланса (% от списанной суммы, 0 = выкл.)
SUBSCRIPTION_REPEAT_PURCHASE_BONUS_PERCENT=5
# На сколько дней выдаётся/продлевается PAYG-подписка (по умолчанию 365).
BILLING_PAYG_SUBSCRIPTION_DAYS=365

# Напоминания в Telegram за ~24 ч и ~3 ч до конца подписки/триала
SUBSCRIPTION_EXPIRY_NOTIFY_ENABLED=true
SUBSCRIPTION_EXPIRY_NOTIFY_INTERVAL_SEC=300

# Рефералы: при /start по ссылке — столько же ₽ на основной баланс и пригласившему, и приглашённому (0 = выкл.)
REFERRAL_SIGNUP_BONUS_RUB=15
# Устарело: фикс. награда за первую покупку тарифа (0 = выкл.; вместо этого REFERRAL_PAYMENT_PERCENT).
# Старые имена: REFERRAL_INVITER_BONUS_RUB / REFERRAL_INVITER_BONUS_DAYS
REFERRAL_INVITER_REWARD_RUB_PER_30_DAYS=0
REFERRAL_INVITER_REWARD_DAYS_PER_30_DAYS=0
# Процент на баланс реферера с платежей приглашённого (пополнение, тариф/слот с баланса). 0 = выкл. Допустимо старое имя REFERRAL_TOPUP_PERCENT.
REFERRAL_PAYMENT_PERCENT=10

# --- Тикет-система ---
# Токен отдельного бота тикетов (BotFather).
TICKETS_BOT_TOKEN=
# ID супергруппы (forum topics) в формате Telegram: -1001234567890
SUPPORT_GROUP_ID=-1001234567890
# Одно напоминание в тему тикета без ответа админа (часы). По умолчанию 12.
REMINDER_HOURS=12
# Автозакрытие при неактивности (дни). По умолчанию 3.
AUTO_CLOSE_DAYS=3
# Макс. размер фото/видео в тикетах (MB) для Telegram и web-admin upload.
TICKETS_MEDIA_MAX_MB=50
# ADMIN_IDS: Telegram ID админов (CSV чисел через запятую).
ADMIN_IDS=

MAINTENANCE_MODE=false
LOG_LEVEL=INFO
DEBUG=false
# --- Web-admin ---
# Публичный HTTPS-origin (без слэша в конце): тот же домен, что в nginx для API/web-admin.
# В BotFather → /setdomain для этого бота — тот же хост. Нужен для Telegram Login Widget (абсолютный data-auth-url).
PUBLIC_SITE_URL=https://admin.your-domain.com
# URL Telegram Mini App для кнопки в боте. Если пусто — берётся {PUBLIC_SITE_URL}/my
# MINIAPP_URL=https://miniapp.your-domain.com/my
# Название и логотип в боковой панели web-admin (при пустом URL — иконка по умолчанию)
ADMIN_PANEL_TITLE=Remna
# Имя на странице «Мой профиль» в web-admin (если пусто — из Telegram/GitHub)
# WEB_ADMIN_PROFILE_DISPLAY_NAME=Enzy
# ADMIN_PANEL_LOGO_URL=https://cdn.example.com/logo.png
# Фон web-admin: default (встроенный) | url (ADMIN_BACKGROUND_URL) | asset (файл из /assets, ADMIN_BACKGROUND_ASSET)
# ADMIN_BACKGROUND_SOURCE=default
# ADMIN_BACKGROUND_URL=
# ADMIN_BACKGROUND_ASSET=
# Секрет cookie-сессии web-admin. В проде обязательно сменить.
WEB_ADMIN_SESSION_SECRET=change-me-in-env
# Cookie сессии только по HTTPS (Secure). Отключайте только для локальной разработки по http.
WEB_ADMIN_SESSION_HTTPS_ONLY=true
# Кому разрешён вход через GitHub (логины через запятую, без @)
WEB_ADMIN_GITHUB_LOGINS=Enzy
# OAuth GitHub для web-admin (Settings -> Developer settings -> OAuth Apps)
WEB_ADMIN_GITHUB_CLIENT_ID=
WEB_ADMIN_GITHUB_CLIENT_SECRET=
# Например: https://admin.your-domain.com/admin/login/github/callback
WEB_ADMIN_GITHUB_REDIRECT_URI=
# Telegram OAuth/OpenID для web-admin (BotFather -> Web Login)
WEB_ADMIN_TELEGRAM_CLIENT_ID=
WEB_ADMIN_TELEGRAM_CLIENT_SECRET=
# Например: https://admin.your-domain.com/admin/login/telegram/widget
WEB_ADMIN_TELEGRAM_REDIRECT_URI=

# --- Crypto Pay (@CryptoBot) ---
CRYPTOBOT_TOKEN=
CRYPTOBOT_STUB=false

# --- Platega.io (https://docs.platega.io — заголовки X-MerchantId / X-Secret) ---
PLATEGA_MERCHANT_ID=
# или старое имя:
# PLATEGA_SHOP_ID=
PLATEGA_SECRET_KEY=
PLATEGA_WEBHOOK_SECRET=
# По документации: https://app.platega.io/ (если не работает — попробуйте https://api.platega.io)
PLATEGA_API_BASE_URL=https://app.platega.io
# Можно один или несколько через запятую: 2=СБП QR, 10=Карты RUB, 11=Карточный эквайринг, 12=Международный эквайринг, 13=Криптовалюта
# Старое имя (одно значение): PLATEGA_PAYMENT_METHOD
PLATEGA_PAYMENT_METHODS=2
# Плательщик выбирает способ на странице Platega (API без фикс. метода /v2/transaction/process)
PLATEGA_PAYER_CHOOSES_METHOD=false
# Совпадают с доменом PUBLIC_SITE_URL / вашим фронтом (после оплаты)
